# 演習3: VULCANO VE-U7 (簡略化 2D、セラミック流路 1 本) — コリウム拡がりの感度解析
#
# 実験 VULCANO VE-U7 (CEA; Journeau et al., Prog. Nucl. Energy 48 (2006) 215):
#   プロトタイプコリウム (UO2 56%, ZrO2 32%, ...)、流入温度 2450 K (固相率 約 50%)
#   セラミック流路への流入 14.0 kg、1.75 kg/s (約 8 s)
#   最終拡がり長さ: セラミック 0.45 m、コンクリート 0.36 m、停止 約 20 s
#   凝固後の厚さ 50-70 mm
# 解析条件は Jubaidah (早稲田大学 博士論文 2021) 第 3 章の single channel 解析に合わせた。
#
# 2D 化 (流路の中心を通る鉛直断面、奥行き 1 m あたり):
#   凝固後の高さ分布 (論文 Fig.17) の面積は約 0.024 m2 (気孔を含む) -> コリウム 0.020 m2
#   るつぼ (幅 0.10 m、コリウム高さ 0.20 m) の底のノズル (幅 2.5 cm、長さ 10 cm) から
#   重力で流れ落ち、流路の入口 (x < 0) に落ちてから拡がる。
#   流量はノズルの粘性抵抗で決まり、約 8 s でほぼ全量が出る。
#
# Type 1 = コリウム, Type 2 = 流路 (床と端の壁、伝熱あり), Type 3 = るつぼ (断熱)
# 粒子間隔 5 mm (論文は 3 mm)。壁は 3 層 (1.5 cm)。12 スレッドで約 4 分。
#   解像度を確かめるときは Spacing と ParticleDistance を 0.003、z の範囲 (+-0.0025) を +-0.0015 にする
#   (粒子 約 2.8 倍、12 スレッドで約 23 分。先端の最終位置は 0.438 -> 0.453 m、実験 0.456 m)

ParticleDistance        0.005

LowerDomain            -0.20000   -0.04000   -0.00250
UpperDomain             0.86000    0.50000    0.00250

# ---------------- るつぼ ----------------
# コリウム 0.10 m x 0.20 m
StartCuboid
Spacing                 0.005
Type                    1
Lower                -0.12500    0.25000   -0.00250
Upper                -0.02500    0.45000    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid

# るつぼ 左壁
StartCuboid
Spacing                 0.005
Type                    3
Lower                -0.14000    0.23500   -0.00250
Upper                -0.12500    0.48000    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid

# るつぼ 右壁
StartCuboid
Spacing                 0.005
Type                    3
Lower                -0.02500    0.23500   -0.00250
Upper                -0.01000    0.48000    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid

# るつぼ 底 (ノズルの左側)
StartCuboid
Spacing                 0.005
Type                    3
Lower                -0.12500    0.23500   -0.00250
Upper                -0.08500    0.25000    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid

# るつぼ 底 (ノズルの右側)
StartCuboid
Spacing                 0.005
Type                    3
Lower                -0.06000    0.23500   -0.00250
Upper                -0.02500    0.25000    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid

# ノズル 左壁 (x = -0.100 .. -0.085, 出口 y = 0.15)
StartCuboid
Spacing                 0.005
Type                    3
Lower                -0.10000    0.15000   -0.00250
Upper                -0.08500    0.23500    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid

# ノズル 右壁 (x = -0.060 .. -0.045)
StartCuboid
Spacing                 0.005
Type                    3
Lower                -0.06000    0.15000   -0.00250
Upper                -0.04500    0.23500    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid

# ---------------- 流路 ----------------
# 床 (x = -0.15 .. 0.80, 上面 y = 0)。 x = 0 が流路の入口 (先端位置の基準)
StartCuboid
Spacing                 0.005
Type                    2
Lower                -0.16500   -0.01500   -0.00250
Upper                 0.81500    0.00000    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid

# 上流端の壁
StartCuboid
Spacing                 0.005
Type                    2
Lower                -0.16500    0.00000   -0.00250
Upper                -0.15000    0.10000    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid

# 下流端の壁 (x = 0.80)
StartCuboid
Spacing                 0.005
Type                    2
Lower                 0.80000    0.00000   -0.00250
Upper                 0.81500    0.10000    0.00250
Velocity              0.00000    0.00000  0.0
EndCuboid
