# 演習2: CCI-2 体系を模した MCCI (コンクリート侵食) の簡略 2D 解析
# 伝熱だけを S = 400 倍速にしている (thermal.data 参照): 計算時間 t [s] = 実時間 400 t [s]
#   EndTime 16 s -> 実時間 約 1.8 時間 (4 スレッドで約 10 分)
# 溶けたコンクリート (軽い) が浮き上がり、溶融物 (重い) が沈むので流速は 0.5 m/s 程度になる。
# Dt = 2.5 ms (CFL 約 0.25)。Dt を大きくすると溶融物が壁を抜けて漏れることがある。
Dt                              2.5e-3
OutputInterval                  0.25
VtkOutputInterval               0.25
EndTime                         16

RadiusRatioA                    2.5
RadiusRatioP                    2.5
RadiusRatioV                    2.5
PpeMaxIteration                 3000
PpeTolerance                    1.0e-7
# 圧力補正の後で位置も動かす x += Dt (u^{n+1} - u*)。0 だと重力だけで毎ステップ g Dt^2 縮む (演習0 で確認)
PpePositionCorrection           1
# 自由表面・壁際の粒子でも補正した圧力勾配を使い、壁粒子は静水圧のゴースト p_w = p_i + rho g.(x_w - x_i)
# 0 だと表面の粒子が約 0.6 g で落ち、壁際の列が約 0.3 g で壁に沿って滑り落ちる (演習0 で確認)
PpeWallGCM                      1
# 密度 (粒子数密度) のずれを各ステップで補正する割合。0 だと溶融物が少しずつ圧縮される
PpeDensityGamma                 0.2

Density                         2300  6000  2300  2300
# Type0 = 溶けたコンクリート (スラグ), Type1 = コリウム液相 [Pa s]
ShearViscosity                  5.0  1.0  5.0  5.0

# 壁の境界条件 (ソルバの既定値から変えているものだけ書く。距離は粒子間隔 dp に対する比)
# 壁の粘性 (no-slip) は壁に沿う向きだけに効かせる / Morris (1997) の方法で壁の速度を外挿する
WallViscTangential              1
WallViscMorris                  1
# 流体粒子の中心が壁粒子の中心にこれ以上近づかない距離
WallMinGapRatio                 0.70
# 壁に近づく粒子は、残りの隙間のこの割合までしか 1 ステップで進めないように Dt を小さくする
WallImpactCfl                   0.25
# 壁の圧力の条件が全部効く距離 / 効かなくなる距離
WallPressureFullRatio           0.90
WallPressureRangeRatio          1.45
# 壁の粘性 (no-slip) が全部効く距離 / 効かなくなる距離 (影響半径 3.5 dp 全体に効かせる)
WallViscFullRatio               3.5
WallViscRangeRatio              3.6

Gravity                         0       -9.81       0.0

# 伝熱・凝固の設定は thermal.data (同じフォルダ)
ThermalDataFile                 thermal.data

# コンクリート = 溶ける固定剛体。固相率が CriticalSolidFraction (thermal.data の Type0) を
# 下回った粒子は剛体から外れて流体 (溶けたコンクリート) になる。
RigidPropertyFile               box.rigid
RigidFixedBodies                1 2 3
