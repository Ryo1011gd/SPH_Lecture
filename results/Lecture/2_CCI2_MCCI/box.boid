# 演習2: CCI-3 体系を模した MCCI (コンクリート侵食) — 「溶けるだけ」の簡略 2D 解析
#
# 実験 CCI-3 (OECD/MCCI, ANL; Farmer et al., OECD/MCCI-2005-TR05):
#   断面 50 cm x 50 cm のキャビティ、相対する 2 面と底面がシリカ系コンクリート
#   (残り 2 面は不活性な MgO 壁)、コリウム約 375 kg (深さ約 25 cm)、初期温度 約 1950 C
#   (数値は概略。授業で使う前に報告書で確認すること)
#
# 2D 化: コンクリート側壁 2 面を通る鉛直断面 (奥行き 1 m あたり)
#   x = 0 .. 0.50 m がキャビティ、y = 0 が床の上面、溶融物の深さ 0.25 m
#   コンクリートは床 25 cm・側壁 15 cm だけモデル化 (床を突き抜けないように床を厚くしている)
#
# Type 0 = コンクリート (溶ける固定剛体、box.rigid で床 = 1, 左壁 = 2, 右壁 = 3)
# Type 1 = 溶融物 (コリウム), Type 2 = 外側の壁 (断熱)
# 粒子間隔 1 cm (10 分で終わるように粗くしている)
# 形状は重ならないように並べている (キャビティ上部は空間)

ParticleDistance        0.01

LowerDomain            -0.20000   -0.30000   -0.00500
UpperDomain             0.70000    0.45000    0.00500

# ---------------- 外側の壁 (断熱、3 層) ----------------
# 底
StartCuboid
Spacing                 0.01
Type                    2
Lower                 -0.18000   -0.28000   -0.00500
Upper                  0.68000   -0.25000    0.00500
Velocity              0.00000    0.00000  0.0
EndCuboid

# 左
StartCuboid
Spacing                 0.01
Type                    2
Lower                 -0.18000   -0.25000   -0.00500
Upper                 -0.15000    0.40000    0.00500
Velocity              0.00000    0.00000  0.0
EndCuboid

# 右
StartCuboid
Spacing                 0.01
Type                    2
Lower                  0.65000   -0.25000   -0.00500
Upper                  0.68000    0.40000    0.00500
Velocity              0.00000    0.00000  0.0
EndCuboid

# ---------------- コンクリート (Type 0、溶ける固定剛体) ----------------
# 床 (rigid 1): 上面 y = 0
StartCuboid
Spacing                 0.01
Type                    0
Lower                 -0.15000   -0.25000   -0.00500
Upper                  0.65000    0.00000    0.00500
Velocity              0.00000    0.00000  0.0
EndCuboid

# 左側壁 (rigid 2): 内面 x = 0
StartCuboid
Spacing                 0.01
Type                    0
Lower                 -0.15000    0.00000   -0.00500
Upper                  0.00000    0.40000    0.00500
Velocity              0.00000    0.00000  0.0
EndCuboid

# 右側壁 (rigid 3): 内面 x = 0.50
StartCuboid
Spacing                 0.01
Type                    0
Lower                  0.50000    0.00000   -0.00500
Upper                  0.65000    0.40000    0.00500
Velocity              0.00000    0.00000  0.0
EndCuboid

# ---------------- 溶融物 (深さ 0.25 m) ----------------
# コリウム
StartCuboid
Spacing                 0.01
Type                    1
Lower                  0.00000    0.00000   -0.00500
Upper                  0.50000    0.25000    0.00500
Velocity              0.00000    0.00000  0.0
EndCuboid
